{
  "name": "pgc/crud-libros",
  "description": "CRUD en memoria de una biblioteca de libros, desarrollado con TDD",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Biblioteca\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Biblioteca\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
